# Copie para .env.local e preencha com os dados do projeto Supabase do Carlos
# (Supabase > Project Settings > API). Na Vercel, as mesmas duas variáveis vão
# em Settings > Environment Variables.
#
# Sem elas o site funciona com as peças da planilha, e o painel (/admin)
# explica o que falta. Ver PAINEL.md.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
